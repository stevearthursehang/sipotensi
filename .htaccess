<IfModule mod_rewrite.c>
    RewriteEngine On

    # -------------------------------------------------------------
    # 1. KEAMANAN: Blokir akses langsung ke file & folder sensitif
    # -------------------------------------------------------------
    # Blokir file .env, git, composer, artisan, dll
    RewriteRule ^(\.env.*|\.git.*|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml)$ - [F,L,NC]

    # Blokir akses ke folder sistem Laravel
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L,NC]

    # -------------------------------------------------------------
    # 2. ROUTING: Alihkan semua request ke folder public/
    # -------------------------------------------------------------
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

# Mencegah directory browsing
Options -Indexes
